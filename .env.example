# The Google Drive folder ID (the part after /folders/ in the URL)
DRIVE_FOLDER_ID=1XM-0CtgvW3PGDekC8qLa2ghxRyvTfjwD

# Base64-encoded Google service account JSON key.
# Generate with:  base64 -w0 service-account.json   (Linux/macOS)
#              or:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))   (PowerShell)
GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional: comma-separated list of domains allowed to call the MCP endpoint
# (empty = allow all). Recommended to set this to restrict access.
ALLOWED_ORIGINS=
